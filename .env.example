DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agent_sandboxing?schema=public
PORT=3000
LOG_LEVEL=info
LOG_COLOR=auto
FIXTURE_REPO_PATH=./repo
FIXTURE_REPOS_ENABLED=true
OPENROUTER_API_KEY=
AGENT_MODEL=openrouter:deepseek/deepseek-v4-flash
AGENT_MAX_STEPS=25
AGENT_BASH_TIMEOUT_MS=120000
AGENT_BASH_OUTPUT_MAX_BYTES=51200
AGENT_READ_MAX_BYTES=262144
AGENT_WRITE_MAX_BYTES=1048576
AGENT_TOOL_TIMEOUT_MS=30000
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_FLUSH_TIMEOUT_MS=2000
LOCAL_TRACE_EXPORT_ENABLED=false
LOCAL_TRACE_EXPORT_PATH=.data/eval-traces.jsonl
EVAL_TRACE_CONTEXT_SNAPSHOT_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app/installations/new
AUTH_COOKIE_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:3000
