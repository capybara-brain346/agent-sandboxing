{
  "name": "agent-sandboxing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:dataset": "tsx tests/evals/run-dataset-evals.ts",
    "eval:dataset:judge": "tsx tests/evals/run-dataset-evals.ts --judge",
    "eval:sandbox-image": "docker build -f Dockerfile.eval -t agent-sandboxing-eval-sandbox:latest .",
    "eval:repo": "npm run eval:sandbox-image && SANDBOX_IMAGE=agent-sandboxing-eval-sandbox:latest tsx tests/evals/run-repo-evals.ts",
    "eval:repo:judge": "npm run eval:sandbox-image && SANDBOX_IMAGE=agent-sandboxing-eval-sandbox:latest tsx tests/evals/run-repo-evals.ts --judge",
    "eval": "npm run eval:dataset && npm run eval:repo",
    "eval:judge": "npm run eval:dataset:judge && npm run eval:repo:judge",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@langfuse/otel": "^4.6.1",
    "@langfuse/tracing": "^4.6.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/client": "^6.14.0",
    "ai": "^7.0.66",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^6.14.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,md,yml,yaml}": "prettier --write"
  }
}
